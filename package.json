{
  "name": "dsh-qq-onebot",
  "version": "1.2.9-rc.1",
  "description": "QQ channel plugin for DeepSeek Harness via OneBot 11 / NapCat — private chats and group chats with your agent.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "docs",
    "src",
    "test",
    "tools",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "TESTING.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "qq",
    "qqbot",
    "onebot",
    "onebot11",
    "napcat",
    "cordis",
    "plugin",
    "chatbot",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "xier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2710586329/dsh-qq.git"
  },
  "homepage": "https://github.com/2710586329/dsh-qq#readme",
  "bugs": {
    "url": "https://github.com/2710586329/dsh-qq/issues"
  },
  "engines": {
    "node": ">=26.0.0",
    "dsh": ">=0.2.2-rc.2"
  },
  "scripts": {
    "test": "node test/run-all.mjs",
    "dev:mock": "node test/simulator.mjs",
    "test:mock": "node test/mock-environment.test.mjs",
    "test:e2e": "node test/e2e.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "image-size": "^2.0.4",
    "ws": "^8.18.0",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.2",
    "@deepseek-ai/dsh-agent-loop": ">=0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.2",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.2",
    "@deepseek-ai/dsh-session-projection": ">=0.2.2-rc.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": false
    },
    "@deepseek-ai/dsh-agent": {
      "optional": false
    },
    "@deepseek-ai/dsh-llm": {
      "optional": false
    },
    "@deepseek-ai/dsh-session": {
      "optional": false
    },
    "@deepseek-ai/schemastery": {
      "optional": false
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tool-testkit": "0.2.2-rc.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
